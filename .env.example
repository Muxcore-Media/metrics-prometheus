# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=metrics-prometheus

# Metrics listen addresses
# METRICS_GRPC_ADDR=127.0.0.1:9900
# METRICS_HTTP_ADDR=:9901
# METRICS_PATH=/metrics

# Inbound gRPC TLS (auto-generated under METRICS_TLS_DIR when unset)
# METRICS_TLS_CERT=/path/to/server.crt
# METRICS_TLS_KEY=/path/to/server.key
# METRICS_TLS_CA=/path/to/ca.crt
# METRICS_TLS_DIR=~/.muxcore/tls/metrics-prometheus
