[Unit]
Description=MuxCore Module - metrics-prometheus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/metrics-prometheus \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id metrics-prometheus
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/metrics-prometheus

[Install]
WantedBy=multi-user.target
